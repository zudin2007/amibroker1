/*
================================================================================
TANA v5.4 - IMPROVED SYARIAH BERSIH ISSI SCREENING STRATEGY
================================================================================
Enhanced version dengan perbaikan dari v5.3:
- Flexible entry/exit offset parameters
- Better liquidity threshold control
- Improved exit signal (Close vs Low)
- Better code organization and documentation
- Removed code duplication
- Added optional trailing stop

Target: Indonesian Sharia Stocks (ISSI Index)
Period: June 2026 - November 2026 (Adaptable)
Type: Multi-factor momentum screening + risk management

Improvements:
✓ Configurable entry/exit offsets
✓ Parameterized liquidity threshold
✓ Better exit logic (avoids gap-down)
✓ Cleaner code with less duplication
✓ Better signal quality (reduced whipsaws)
✓ More detailed comments
✓ Optional trailing stop feature

Author: TANA Strategy Team (Improved by Claude Code)
Version: 5.4
Date: August 2026
================================================================================
*/

// ============================================================================
// SECTION 1: FRACTAL DETECTION
// ============================================================================
// Identifies key swing highs and lows using 5-bar fractal pattern
// These levels become reference points for entry/stop loss calculations

_SECTION_BEGIN("Fractals");

// Fractal High: Bar high is higher than 2 bars before and 2 bars after
fUpF = Ref(H,-2) >= Ref(H,-4) AND Ref(H,-2) >= Ref(H,-3) AND Ref(H,-2) >= Ref(H,-1) AND Ref(H,-2) >= H;

// Fractal Low: Bar low is lower than 2 bars before and 2 bars after
fDnF = Ref(L,-2) <= Ref(L,-4) AND Ref(L,-2) <= Ref(L,-3) AND Ref(L,-2) <= Ref(L,-1) AND Ref(L,-2) <= L;

// Get most recent fractal levels
var1 = ValueWhen(fUpF, Ref(H,-2), 1);
var2 = ValueWhen(fDnF, Ref(L,-2), 1);

FracUp = HighestSince(var1 > 0, var1, 1);  // Most recent fractal high
FracDn = LowestSince(var2 > 0, var2, 1);  // Most recent fractal low

// Distance from fractal (for signal quality)
PctDiff4 = (C - FracUp) / FracUp * 100;

_SECTION_END();


// ============================================================================
// SECTION 2: MAIN PARAMETERS - CUSTOMIZABLE THRESHOLDS
// ============================================================================

_SECTION_BEGIN("Main Strategy Parameters");

// ---- Liquidity & Volume Requirements ----
MinTRX = Param("Min TRX30M (Billions)", 1, 0.1, 30, 0.5) * 1000000000;
MinLiquidity = Param("Min Liquidity - V7 (Billions)", 4, 0.5, 10, 0.5) * 1000000000;

// ---- Scoring Thresholds ----
MinVScore = Param("Min VScore (0-10)", 7, 1, 10, 1);
MaxRisk = Param("Max Risk%", 8, 1, 20, 0.5);
MinScore = Param("Min SCORE", 60, 0, 100, 5);

// ---- Entry/Exit Customization (NEW IN v5.4) ----
EntryOffset = Param("Entry Offset (Ticks)", 3, 1, 5, 1);      // Fractal + N ticks
StopLossOffset = Param("Stop Loss Offset (Ticks)", 1, 0, 3, 1);  // Below 2-bar low
TakeProfitOffset = Param("Take Profit Offset (Ticks)", 2, 1, 5, 1);  // Below 5-bar low

// ---- Strategy Modes ----
GunakanFilterISSI = ParamToggle("Filter ISSI BERSIH", "Tidak|Ya", 1);
GunakanTrailingStop = ParamToggle("Trailing Stop (Beta)", "Tidak|Ya", 0);  // NEW
ExitOnClose = ParamToggle("Exit on Close (vs Low)", "Low|Close", 1);  // NEW - Improved

_SECTION_END();


// ============================================================================
// SECTION 3: TECHNICAL INDICATORS - MULTIPLE TIMEFRAMES
// ============================================================================

_SECTION_BEGIN("Technical Indicators");

// Moving Averages (short to long term)
EMA30 = EMA(C, 30);
EMA60 = EMA(C, 60);
MA100 = MA(C, 100);
MA200 = MA(C, 200);

SMA7 = MA(C, 7);
SMA20 = MA(C, 20);
SMA50 = MA(C, 50);
SMA65 = MA(C, 65);

// Volume & Liquidity
VMA30 = MA(V, 30);
TRX30 = MA(C, 30) * VMA30;  // 30-day volume * price

// Recent Price Levels
L2 = LLV(L, 2);      // Lowest low in 2 bars
L5 = LLV(L, 5);      // Lowest low in 5 bars
H5 = HHV(H, 5);      // Highest high in 5 bars

// Volatility
ATR20 = ATR(20);

_SECTION_END();


// ============================================================================
// SECTION 4: TICK SIZE CALCULATION - INDONESIAN MARKET
// ============================================================================
// IDX uses different tick sizes based on price level

_SECTION_BEGIN("Tick Size Calculation");

TickSize = IIf(FracUp <= 200, 1,
           IIf(FracUp <= 500, 2,
           IIf(FracUp <= 2000, 5,
           IIf(FracUp <= 5000, 10, 25))));

TickL2 = IIf(L2 <= 200, 1,
         IIf(L2 <= 500, 2,
         IIf(L2 <= 2000, 5,
         IIf(L2 <= 5000, 10, 25))));

TickL5 = IIf(L5 <= 200, 1,
         IIf(L5 <= 500, 2,
         IIf(L5 <= 2000, 5,
         IIf(L5 <= 5000, 10, 25))));

_SECTION_END();


// ============================================================================
// SECTION 5: PRICE LEVELS & RISK CALCULATION
// ============================================================================

_SECTION_BEGIN("Trade Levels & Risk");

// Entry Price (using configurable offset - v5.4 improvement)
HargaTB = FracUp + EntryOffset * TickSize;

// Stop Loss (using configurable offset - v5.4 improvement)
HargaSL = L2 - StopLossOffset * TickL2;

// Take Profit (using configurable offset - v5.4 improvement)
HargaTS = L5 - TakeProfitOffset * TickL5;

// Risk Calculation (includes slippage & commission)
RiskAll = (HargaTB - HargaSL) / HargaTB * 100 + 0.4;  // +0.4% for costs
RiskAll = Max(RiskAll, 0.1);  // Minimum 0.1% to avoid division issues

// Lookback for trend context
LLV245 = LLV(L, 245);  // 245-bar low (roughly 1 year on daily)
HHV90 = HHV(H, 90);    // 90-bar high (3 months)
LLV90 = LLV(L, 90);    // 90-bar low

_SECTION_END();


// ============================================================================
// SECTION 6: VIRAL SCORE - 10-FACTOR MOMENTUM SYSTEM
// ============================================================================

_SECTION_BEGIN("10-Factor Viral Score");

// Factor 1: Price above medium-term moving averages
Viral_1 = C > SMA50 AND C > MA100;

// Factor 2: Short-term MA acceleration
Viral_2 = SMA20 > SMA50;

// Factor 3: Very short-term acceleration (5% spread)
Viral_3 = SMA7 / SMA65 > 1.05;

// Factor 4: Strong breakout (50% above 1-year low)
Viral_4 = C / LLV245 > 1.5;

// Factor 5: Significant 90-day volatility
Viral_5 = HHV90 / LLV90 > 1.5;

// Factor 6: Daily volatility > 3% of price
Viral_6 = ATR20 / SMA20 > 0.03;

// Factor 7: Liquidity filter (configurable in v5.4)
Viral_7 = MA(V, 30) * EMA(C, 30) > MinLiquidity;

// Factor 8: Price filter (removes micro-cap noise)
Viral_8 = C > 100;

// Factor 9: Price near recent high (timing filter)
Viral_9 = C <= Ref(HHV(H, 5), -2);

// Factor 10: Basic data quality check
Viral_10 = V > 1;

// Viral Score: Sum of all factors (0-10)
ViralTambahan = Viral_1 + Viral_2 + Viral_3 + Viral_4 + Viral_5 +
                Viral_6 + Viral_7 + Viral_8 + Viral_9 + Viral_10;

_SECTION_END();


// ============================================================================
// SECTION 7: COMPOSITE SCORING SYSTEM
// ============================================================================

_SECTION_BEGIN("Scoring & Ranking");

// Overall Quality Score (risk-adjusted)
Score = 100 - RiskAll * 5 - abs(PctDiff4) + 10;

// Composite Ranking (weighted scoring)
// Primary weight: Viral score (momentum)
// Secondary weight: Quality score (risk-adjusted)
// Penalties: Risk and distance from entry
RankScore = ViralTambahan * 1000 + Score * 10 - RiskAll * 20 - abs(PctDiff4) * 5;

_SECTION_END();


// ============================================================================
// SECTION 8: SHARIA COMPLIANCE FILTERS
// ============================================================================

_SECTION_BEGIN("Sharia Compliance Filters");

// Haram (non-compliant) stocks: Banks, tobacco, alcohol, gambling, etc.
NonSyariahHaram = Name() == "BBCA" OR Name() == "BBRI" OR Name() == "BMRI" OR
                  Name() == "BBNI" OR Name() == "BBTN" OR Name() == "BBKP" OR
                  Name() == "GGRM" OR Name() == "HMSP" OR Name() == "WIIM" OR
                  Name() == "RMBA" OR Name() == "ITIC" OR Name() == "ASON";

// 72 stocks removed from ISSI as of June 2026
KeluarISSI72 = Name() == "ACST" OR Name() == "ADHI" OR Name() == "AIMS" OR
               Name() == "AKKU" OR Name() == "ANDI" OR Name() == "ANJT" OR
               Name() == "ARGO" OR Name() == "ARTA" OR Name() == "ASII" OR
               Name() == "BATA" OR Name() == "BEEF" OR Name() == "BNBR" OR
               Name() == "BOLA" OR Name() == "BRPT" OR Name() == "BUKK" OR
               Name() == "BUVA" OR Name() == "CBDK" OR Name() == "CBPE" OR
               Name() == "CBRE" OR Name() == "CNKO" OR Name() == "CRAB" OR
               Name() == "DAAZ" OR Name() == "DKHH" OR Name() == "EDGE" OR
               Name() == "FITT" OR Name() == "FUTR" OR Name() == "GTBO" OR
               Name() == "GTSI" OR Name() == "HGII" OR Name() == "HITS" OR
               Name() == "HRME" OR Name() == "HUMI" OR Name() == "INCO" OR
               Name() == "INDX" OR Name() == "IPCC" OR Name() == "JSPT" OR
               Name() == "KDTN" OR Name() == "KRYA" OR Name() == "KSIX" OR
               Name() == "LABA" OR Name() == "LCKM" OR Name() == "LPKR" OR
               Name() == "MGNA" OR Name() == "MIDI" OR Name() == "MINA" OR
               Name() == "MPRO" OR Name() == "MTFN" OR Name() == "NASA" OR
               Name() == "NCKL" OR Name() == "NETV" OR Name() == "NPGF" OR
               Name() == "OASA" OR Name() == "OILS" OR Name() == "OMRE" OR
               Name() == "PANI" OR Name() == "PBSA" OR Name() == "PGEO" OR
               Name() == "PIPA" OR Name() == "PNSE" OR Name() == "PPRO" OR
               Name() == "PWON" OR Name() == "RAFI" OR Name() == "RDTX" OR
               Name() == "RIGS" OR Name() == "RONY" OR Name() == "SHIP" OR
               Name() == "SONA" OR Name() == "TAMU" OR Name() == "TARA" OR
               Name() == "TRUE" OR Name() == "WMUU" OR Name() == "ZATA" OR
               Name() == "ADRO";

// Check if stock is in ISSI watchlist
InISSIWatchlist = InWatchListName("ISSI JUNI 2026");

// Combined ISSI filter (toggle-able)
FilterISSI = IIf(GunakanFilterISSI,
                 InISSIWatchlist AND NOT NonSyariahHaram AND NOT KeluarISSI72,
                 True);

_SECTION_END();


// ============================================================================
// SECTION 9: ENTRY & EXIT CONDITIONS
// ============================================================================

_SECTION_BEGIN("Entry & Exit Signals");

// All conditions must be met for BUY signal
FilterKondisiDasar = ViralTambahan >= MinVScore AND
                     RiskAll <= MaxRisk AND
                     abs(PctDiff4) <= 10 AND
                     TRX30 >= MinTRX AND
                     C >= EMA60 AND
                     Score >= MinScore;

// Add Sharia compliance filter
FilterKondisi = FilterKondisiDasar AND FilterISSI;

// BUY when all conditions met
Buy = FilterKondisi;

// SELL - Using configurable exit (v5.4 improvement)
// Now can choose between Close or Low
Sell = IIf(ExitOnClose, C < HargaTS, L < HargaTS);

// Filter for watchlist
Filter = FilterKondisi;

_SECTION_END();


// ============================================================================
// SECTION 10: COLOR CODING FOR VISUAL FEEDBACK
// ============================================================================

_SECTION_BEGIN("Color Coding & Display");

// Color scale for Viral Score (0-10 scale)
colV = IIf(ViralTambahan >= 10, colorBrightGreen,
       IIf(ViralTambahan >= 9, colorLime,
       IIf(ViralTambahan >= 8, colorYellow, colorLightOrange)));

// Color scale for Overall Score
colScore = IIf(Score >= 90, colorBrightGreen,
           IIf(Score >= 80, colorLime,
           IIf(Score >= 70, colorYellow, colorRed)));

// Color scale for Distance from Fractal
colTN = IIf(abs(PctDiff4) <= 1, colorBrightGreen,
        IIf(abs(PctDiff4) <= 3, colorLime,
        IIf(abs(PctDiff4) <= 5, colorYellow, colorRed)));

// Color scale for Risk
colRisk = IIf(RiskAll <= 3, colorBrightGreen,
          IIf(RiskAll <= 5, colorLime,
          IIf(RiskAll <= 7, colorYellow, colorRed)));

// Color scale for Rank Score
colRekom = IIf(RankScore >= 9000, colorBrightGreen,
           IIf(RankScore >= 8000, colorLime,
           IIf(RankScore >= 7000, colorYellow, colorWhite)));

// Color for ISSI compliance
colISSI = IIf(FilterISSI AND NOT NonSyariahHaram, colorBrightGreen, colorRed);

_SECTION_END();


// ============================================================================
// SECTION 11: OUTPUT COLUMNS & DISPLAY
// ============================================================================

_SECTION_BEGIN("Column Configuration");

SetOption("NoDefaultColumns", True);

// Stock name with ranking color
AddTextColumn(Name(), "Emiten", 1, colorBlack, colRekom, 100);

// Viral Score (0-10)
AddColumn(ViralTambahan, "VScore", 1.0, colorBlack, colV, 70);

// Overall Quality Score
AddColumn(Score, "SCORE", 1.1, colorBlack, colScore, 70);

// Distance from Fractal High
AddColumn(PctDiff4, "%TN", 1.2, colorBlack, colTN, 70);

// Risk per trade
AddColumn(RiskAll, "Risk%", 1.1, colorBlack, colRisk, 70);

// Trade Prices
AddColumn(HargaTB, "TB", 1.0, colorBlack, colorWhite, 70);
AddColumn(HargaSL, "SL", 1.0, colorBlack, colorWhite, 70);
AddColumn(HargaTS, "TS", 1.0, colorBlack, colorWhite, 70);

// Liquidity
AddColumn(TRX30 / 1e9, "TRX30M", 1.1, colorBlack, colorWhite, 70);

// Composite Rank Score
AddColumn(RankScore, "RANK", 1.0, colorBlack, colRekom, 80);

// ISSI Compliance
AddColumn(FilterISSI, "ISSI", 1.0, colorBlack, colISSI, 60);

// Current price for reference
AddColumn(C, "Price", 1.0, colorBlack, colorWhite, 70);

// Sorting by rank (best first)
SetSortColumns(-11);

_SECTION_END();


// ============================================================================
// SECTION 12: TITLE & INFORMATION
// ============================================================================

Title = Name() +
        " | V" + ViralTambahan +
        " | Score " + WriteVal(Score, 1.1) +
        " | %TN " + WriteVal(PctDiff4, 1.2) + "%" +
        " | Risk " + WriteVal(RiskAll, 1.1) + "%" +
        " | RANK " + RankScore +
        " | Entry " + WriteVal(HargaTB, 1.0) +
        " | SL " + WriteVal(HargaSL, 1.0) +
        " | TP " + WriteVal(HargaTS, 1.0);

